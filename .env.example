# Copy to .env on the server and fill in. Never commit the real .env.
NODE_ENV=production
PUBLIC_URL=https://heyquicky.com
DOMAIN=heyquicky.com

# MongoDB. The Docker Compose files set this for you (mongodb://mongo:27017/quicky).
MONGODB_URI=mongodb://127.0.0.1:27017/quicky

# AI chat agent (Bangla/Banglish replies). Leave the key empty to keep AI off.
# Create a key at https://platform.claude.com/ (API keys).
ANTHROPIC_API_KEY=
# Optional: model and reasoning effort for replies (defaults shown).
AI_MODEL=claude-haiku-5-5
AI_EFFORT=low

# Meta app "Quicky" (App settings → Basic)
META_APP_ID=1472241481412452
META_APP_SECRET=
# Any random string; enter the same one when the webhook is set up.
# Create one with: node -e "console.log(require('crypto').randomBytes(16).toString('hex'))"
META_VERIFY_TOKEN=
META_GRAPH_VERSION=v23.0
# Facebook Login for Business → Configurations (optional for Messenger/Instagram, required for WhatsApp)
META_LOGIN_CONFIG_ID=
META_WHATSAPP_CONFIG_ID=

# 64 hex characters. Create once with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Back it up: if it is lost every channel must be connected again.
TOKEN_ENCRYPTION_KEY=

# Shown on /privacy, /terms and /data-deletion
OPERATOR_NAME=Quicky
SUPPORT_EMAIL=info@heyquicky.com
# Password for https://your-site/admin/leads.csv (sign-up leads to follow up; user name: admin). Empty = off.
ADMIN_TOKEN=

# ---------- Dashboard (all optional; each service runs in a safe "fake" mode until set) ----------
# Free AI credit (taka) added when a shop first goes live. 0 until prices are decided.
TRIAL_CREDIT=0
# Estimated cost of one AI reply in taka, for "≈ N AI replies left" before there is real usage.
AI_REPLY_ESTIMATE=0.133
# AI credit: each call is priced from real token use × USD_TO_BDT × (1 + AI_MARKUP_PCT / 100).
# Leave AI_CREDIT_ENFORCED off until shops have credit (e.g. TRIAL_CREDIT); when on, the AI pauses at ৳0.
USD_TO_BDT=122
AI_MARKUP_PCT=0
AI_CREDIT_ENFORCED=
# Voice notes to text with OpenAI (gpt-transcribe, $0.0045 a minute, charged like AI replies). Leave empty to send voice notes to the team.
OPENAI_API_KEY=
TRANSCRIBE_MODEL=gpt-transcribe
# Password reset codes by email (Resend) and SMS (your provider's send URL with {to}, {text}, {key}).
RESEND_API_KEY=
MAIL_FROM=HeyQuicky <no-reply@heyquicky.com>
SMS_API_URL=
SMS_API_KEY=
# "Continue with Google" on the log-in page.
GOOGLE_CLIENT_ID=
# Web push for the mobile dashboard (generate with: npx web-push generate-vapid-keys).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:info@heyquicky.com
# Courier fraud check (cross-merchant delivery success). {phone} is replaced with the number.
FRAUDCHECK_API_URL=
FRAUDCHECK_API_KEY=
# Shown in the dashboard help panel.
# Manual AI-credit top-ups: HeyQuicky's own bKash / Nagad numbers. Shops send money and enter the TrxID;
# credit is added only after you approve it (GET /admin/topups, POST /admin/topups/:id/approve, password = ADMIN_TOKEN).
TOPUP_BKASH_NUMBER=
TOPUP_NAGAD_NUMBER=
# Plan prices (৳/month) and AI replies included, e.g. starter:999,growth:2499,pro:5999. Empty = "Price coming soon".
PLAN_PRICES=
PLAN_REPLIES=
SUPPORT_WHATSAPP=
# Force every adapter into fake mode (tests, demos).
ADAPTERS=
