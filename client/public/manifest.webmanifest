{
  "name": "HeyQuicky",
  "short_name": "HeyQuicky",
  "description": "AI sales inbox for online shops — chats, orders and couriers in one place.",
  "id": "/app/",
  "start_url": "/app/",
  "scope": "/app/",
  "display": "standalone",
  "orientation": "portrait-primary",
  "background_color": "#F6F6F2",
  "theme_color": "#2B4BFF",
  "lang": "en",
  "icons": [
    { "src": "/app/icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/app/icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/app/icons/maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "Inbox", "url": "/app/inbox", "icons": [{ "src": "/app/icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Orders", "url": "/app/orders", "icons": [{ "src": "/app/icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "New order", "url": "/app/orders/new", "icons": [{ "src": "/app/icons/icon-192.png", "sizes": "192x192" }] }
  ]
}
